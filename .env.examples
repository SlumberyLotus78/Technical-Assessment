# Copiar a .env y completar los valores en el archivo privado.
FRED_API_KEY=
BANXICO_TOKEN=
# Conexión PostgreSQL privada; especificar la base del proyecto explícitamente.
# Formato: postgresql://usuario:contrasena@localhost:5432/nombre_base
DATABASE_URL=
# Conexión opcional para pruebas SQL; base independiente con prefijo grain_test_.
# Se utiliza explícitamente con python -m tests.run --postgres --env-file .env.
TEST_DATABASE_URL=